    <string name="dolby_dialogue_summary">Nutq va vokalni oldinga chiqaring. Yoqilgandan keyin quyida kuchini sozlang.</string>
    <string name="dolby_dialogue_strength_title">Ovozni yaxshilash kuchi</string>
    <string name="dolby_tuning_help">O‘zgarishlar har bir profil uchun alohida saqlanadi. Grafik ekvalayzerni bevosita boshqarish uchun aqlli EQ-ni o‘chiring. Surround boshqaruvlari faol media chiqishiga mos keladi. Dinamik rejim ishlov berishni kontentga moslashtirishi mumkin.</string>
    <string name="dolby_geq_profile_heading">Sozlash: %1$s</string>
