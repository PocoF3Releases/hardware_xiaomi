    <string name="dolby_bass_summary">Nhấn mạnh các tần số thấp. Sử dụng bộ cân bằng đồ họa để tinh chỉnh âm trầm chính xác hơn.</string>
    <string name="dolby_volume_summary">Giảm chênh lệch độ lớn giữa các bản nhạc và các đoạn yên tĩnh hoặc lớn tiếng.</string>
    <string name="dolby_speaker_summary">Tạo cảm giác âm thanh vòm rộng hơn cho loa tích hợp.</string>
    <string name="dolby_headphone_summary">Tạo cảm giác âm thanh vòm khi nghe qua tai nghe.</string>
    <string name="dolby_dialogue_summary">Làm nổi bật lời nói và giọng hát. Sau khi bật, điều chỉnh mức độ ở bên dưới.</string>
    <string name="dolby_dialogue_strength_title">Cường độ tăng cường giọng nói</string>
    <string name="dolby_tuning_help">Các thay đổi được lưu riêng cho từng hồ sơ. Tắt EQ thông minh để điều khiển trực tiếp bộ cân bằng đồ họa. Điều khiển âm thanh vòm sẽ theo đầu ra phương tiện đang hoạt động. Chế độ Động có thể điều chỉnh quá trình xử lý theo nội dung.</string>
    <string name="dolby_geq_profile_heading">Tinh chỉnh: %1$s</string>
    <string name="dolby_geq_band_frequency">Dải %1$d · %2$d Hz</string>
    <string name="dolby_geq_graph_hint">Chạm vào một dải rồi kéo lên hoặc xuống để điều chỉnh; thả ra để áp dụng.</string>
    <string name="dolby_geq_graph_description">Đồ thị bộ cân bằng 20 dải. Tần số tăng từ trái sang phải; độ khuếch đại nằm trong khoảng âm 10 đến dương 10 dB. Sử dụng các điều khiển dải bên dưới để điều chỉnh chính xác.</string>
