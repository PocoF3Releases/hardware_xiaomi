    <string name="dolby_bass_summary">Zvýraznite nízke frekvencie. Na jemnejšie úpravy basov použite grafický ekvalizér.</string>
    <string name="dolby_volume_summary">Znížte rozdiely v hlasitosti medzi skladbami a tichými alebo hlasnými pasážami.</string>
