    <string name="dolby_bass_summary">Thekso frekuencat e ulëta. Përdor barazuesin grafik për rregullime më të imta të basit.</string>
    <string name="dolby_volume_summary">Zvogëlo dallimet e fortësisë së zërit midis pjesëve dhe pasazheve të qeta ose të zhurmshme.</string>
    <string name="dolby_speaker_summary">Shto një përshtypje më të gjerë rrethuese te altoparlantët e integruar.</string>
    <string name="dolby_headphone_summary">Shto një përshtypje rrethuese kur dëgjon me kufje.</string>
    <string name="dolby_dialogue_summary">Nxirr në pah të folurën dhe vokalet. Pas aktivizimit, rregullo intensitetin më poshtë.</string>
    <string name="dolby_dialogue_strength_title">Fuqia e përmirësimit të zërit</string>
    <string name="dolby_tuning_help">Ndryshimet ruhen veçmas për çdo profil. Çaktivizo EQ-në inteligjente për kontroll të drejtpërdrejtë të barazuesit grafik. Kontrollet rrethuese ndjekin daljen aktive të medias. Modaliteti Dinamik mund ta përshtatë përpunimin me përmbajtjen.</string>
    <string name="dolby_geq_profile_heading">Rregullimi: %1$s</string>
    <string name="dolby_geq_band_frequency">Brezi %1$d · %2$d Hz</string>
    <string name="dolby_geq_graph_hint">Prek një brez dhe tërhiqe lart ose poshtë për ta rregulluar; lëshoje për ta zbatuar.</string>
    <string name="dolby_geq_graph_description">Grafik barazuesi me 20 breza. Frekuenca rritet nga e majta në të djathtë; përforcimi varion nga minus 10 në plus 10 dB. Përdor kontrollet e brezave më poshtë për rregullime të sakta.</string>
    <string name="dolby_geq_previous_band">Brezi i mëparshëm i frekuencës</string>
