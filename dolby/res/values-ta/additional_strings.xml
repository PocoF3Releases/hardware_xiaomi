    <string name="dolby_reset_profile_message">தற்போதைய சுயவிவரத்தை அதன் தொழிற்சாலை அமைப்புகளுக்கு மீட்டெடுக்கவா? சேமித்த சமநிலைப்படுத்தி முன்னமைவுகள் பாதுகாக்கப்படும்.</string>
    <string name="dolby_setting_failed">Dolby இந்த அமைப்பைப் பயன்படுத்த முடியவில்லை. மீண்டும் முயற்சிக்கவும்.</string>
    <string name="dolby_geq_gain_db">%1$+.1f dB</string>
    <string name="dolby_bass_summary">குறைந்த அதிர்வெண்களை வலுப்படுத்தவும். பேஸை நுணுக்கமாகச் சரிசெய்ய வரைகலை சமநிலைப்படுத்தியைப் பயன்படுத்தவும்.</string>
    <string name="dolby_volume_summary">பாடல்களுக்கும் அமைதியான அல்லது அதிக ஒலி பகுதிகளுக்கும் இடையிலான ஒலி வலிமை வேறுபாடுகளைக் குறைக்கவும்.</string>
    <string name="dolby_speaker_summary">உள்ளமைந்த ஸ்பீக்கர்களுக்கு விரிந்த சுற்றொலி உணர்வைச் சேர்க்கவும்.</string>
    <string name="dolby_headphone_summary">ஹெட்ஃபோனில் கேட்கும் போது சுற்றொலி உணர்வைச் சேர்க்கவும்.</string>
    <string name="dolby_dialogue_summary">பேச்சையும் குரலையும் முன்னிறுத்தவும். இயக்கிய பிறகு கீழே அதன் அளவைச் சரிசெய்யவும்.</string>
    <string name="dolby_dialogue_strength_title">குரல் மேம்பாட்டு வலிமை</string>
    <string name="dolby_tuning_help">மாற்றங்கள் ஒவ்வொரு சுயவிவரத்திற்கும் தனித்தனியாகச் சேமிக்கப்படும். வரைகலை சமநிலைப்படுத்தியை நேரடியாகக் கட்டுப்படுத்த நுண்ணறிவு EQ ஐ முடக்கவும். சுற்றொலி கட்டுப்பாடுகள் செயலில் உள்ள ஊடக வெளியீட்டை பின்பற்றும். டைனமிக் உள்ளடக்கத்துக்கு ஏற்ப செயலாக்கத்தை மாற்றக்கூடும்.</string>
